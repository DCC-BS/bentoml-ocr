# ── Docker Compose settings ──────────────────────────────────────────────────

# Hugging Face token for downloading gated models (GLM-OCR)
# HF_TOKEN=

# Host directory for the HF model cache (default: .hf-cache — a named volume)
# HF_CACHE_DIR=~/.cache/huggingface

# Host-exposed ports
# VLLM_HOST_PORT=8001
# DOCLING_HOST_PORT=5001

# Upstream docling-serve image tag used when building the patched image
# DOCLING_SERVE_TAG=latest

# Docling log level (default: INFO)
# DOCLING_SERVE_LOG_LEVEL=INFO
