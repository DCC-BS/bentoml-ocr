# ── Docker Compose settings ──────────────────────────────────────────────────

# Hugging Face token for downloading gated models (GLM-OCR)
# HF_TOKEN=

# Host directory for the HF model cache (default: .hf-cache — a named volume)
# HF_CACHE_DIR=~/.cache/huggingface

# Host-exposed ports
# VLLM_HOST_PORT=8001
# DOCLING_HOST_PORT=5001

# URL where docling-serve is accessible (used by e2e tests and smoke_test.sh)
DOCLING_SERVE_URL=http://localhost:5001

# Upstream docling-serve image tag used when building the patched image
# DOCLING_SERVE_TAG=latest

# Docling log level (default: INFO)
# DOCLING_SERVE_LOG_LEVEL=INFO

# ── GLM-OCR plugin settings ───────────────────────────────────────────────────

# Bearer token sent in the Authorization header when calling the vLLM server.
# Required if your vLLM instance is behind an authenticated proxy or gateway.
# GLMOCR_REMOTE_OCR_API_KEY=
