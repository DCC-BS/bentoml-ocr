# Production mode — controls structured (JSON) vs. human-readable logging (default: false)
IS_PROD=false
# The URL for the vLLM chat completions endpoint
VLLM_API_URL="http://localhost:8001/v1/chat/completions"
# API token for authenticating with the vLLM server (optional)
# VLLM_API_KEY=
# The model name to use for vLLM requests
VLLM_MODEL_NAME="zai-org/GLM-OCR"
# Timeout in seconds for OCR requests (default: 300)
# GLMOCR_REQUEST_TIMEOUT_SECONDS=300
# Enable layout analysis in GLM-OCR (default: true)
# GLMOCR_ENABLE_LAYOUT=true
# Maximum number of concurrent workers (default: 16)
# GLMOCR_MAX_WORKERS=16
# Logging level (default: INFO)
# LOG_LEVEL=INFO
# Optional path to GLM-OCR config file
# GLMOCR_CONFIG_PATH=
# Maximum request body size in bytes (default: 50 MiB)
# MAX_BODY_SIZE_BYTES=52428800
# Maximum concurrent HTTP connections to vLLM (default: 100)
# MAX_HTTP_CONNECTIONS=100
# Maximum keep-alive HTTP connections to vLLM (default: 20)
# MAX_KEEPALIVE_CONNECTIONS=20
# Retry settings for transient vLLM errors
# RETRY_MAX_ATTEMPTS=3
# RETRY_BACKOFF_BASE_SECONDS=0.5
# RETRY_BACKOFF_MAX_SECONDS=8.0
