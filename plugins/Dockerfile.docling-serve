ARG DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve
ARG DOCLING_SERVE_TAG=latest
FROM ${DOCLING_SERVE_IMAGE}:${DOCLING_SERVE_TAG}

# PP-OCRv6 onnxruntime wheel; override with "onnxruntime>=1.17" for CPU images.
ARG ONNXRUNTIME_PACKAGE="onnxruntime-gpu>=1.17"

RUN pip install --no-cache-dir "huggingface-hub>=1.3.0" \
    && pip install --no-cache-dir --no-deps docling-glm-ocr docling-pp-doc-layout docling-pp-ocrv6 \
    && pip install --no-cache-dir "transformers>=5.1.0" \
    && pip install --no-cache-dir "rapidocr>=3.0" "pyyaml>=6.0" \
    # install the chosen wheel last so it overwrites the CPU onnxruntime rapidocr pulls in
    && pip install --no-cache-dir --force-reinstall --no-deps "${ONNXRUNTIME_PACKAGE}"

RUN python -c "from docling_pp_ocrv6 import PPOCRv6Model; PPOCRv6Model.download_models()"

COPY gradio_ui.py /tmp/gradio_ui.py
RUN cp /tmp/gradio_ui.py \
    "$(python -c 'from pathlib import Path; import docling_serve; print(Path(docling_serve.__file__).parent / "gradio_ui.py")')"
