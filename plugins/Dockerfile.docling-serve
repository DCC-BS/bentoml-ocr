ARG DOCLING_SERVE_IMAGE=ghcr.io/docling-project/docling-serve
ARG DOCLING_SERVE_TAG=latest
FROM ${DOCLING_SERVE_IMAGE}:${DOCLING_SERVE_TAG}

RUN pip install --no-cache-dir "huggingface-hub>=1.3.0" \
    && pip install --no-cache-dir --no-deps docling-glm-ocr docling-pp-doc-layout \
    && pip install --no-cache-dir gradio

COPY gradio_ui.py /tmp/gradio_ui.py
RUN cp /tmp/gradio_ui.py \
    "$(python -c 'from pathlib import Path; import docling_serve; print(Path(docling_serve.__file__).parent / "gradio_ui.py")')"

# Mute health-probe log records (site-packages drop-in, no upstream file touched)
COPY mute_health_logs.py /tmp/mute_health_logs.py
RUN SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')" \
    && cp /tmp/mute_health_logs.py "$SP/dcc_mute_health_logs.py" \
    && printf 'import dcc_mute_health_logs\n' > "$SP/zz_dcc_mute_health_logs.pth"
